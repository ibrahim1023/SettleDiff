# Hyperfusion — required for live model explanations and the live Hyperfusion contract.
SETTLEDIFF_HYPERFUSION_BASE_URL=
SETTLEDIFF_HYPERFUSION_API_KEY=
SETTLEDIFF_HYPERFUSION_MODEL=

# Context.dev — API key required for every live investigation.
# Optional override: SETTLEDIFF_CONTEXTDEV_BASE_URL=https://api.context.dev/v1
SETTLEDIFF_CONTEXTDEV_API_KEY=

# Local persistence — optional; commands may also receive --database explicitly.
SETTLEDIFF_DATABASE_PATH=

# OpenTelemetry — optional. Use HTTPS remotely; HTTP is accepted only for loopback collectors.
SETTLEDIFF_OTLP_ENDPOINT=

# x402 — command is a JSON array; wallet secrets belong to the external signer environment. RPC URLs are treated as sensitive because provider tokens may appear in their path.
SETTLEDIFF_X402_SIGNER_COMMAND=
SETTLEDIFF_X402_RPC_URL=
SETTLEDIFF_X402_TESTNET_ENABLED=

# Explicit live gates — keep blank during ordinary development and CI.
# Set a gate to 1 only for an owner-authorized invocation.
SETTLEDIFF_LIVE_HYPERFUSION=
SETTLEDIFF_LIVE_CONTEXTDEV=
SETTLEDIFF_LIVE_CONTEXTDEV_URL=
SETTLEDIFF_LIVE_CONTEXTDEV_CLAIM=

# Reserved paid-test gate. The current paid path still requires the interactive CLI authorization.
SETTLEDIFF_ALLOW_PAID_TEST=

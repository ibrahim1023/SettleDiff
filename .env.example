# Hyperfusion (required only for live model use)
SETTLEDIFF_HYPERFUSION_BASE_URL=
SETTLEDIFF_HYPERFUSION_API_KEY=
SETTLEDIFF_HYPERFUSION_MODEL=

# Local persistence (optional; the application default is used when empty)
SETTLEDIFF_DATABASE_PATH=

# Supporting integrations (optional)
SETTLEDIFF_CONTEXTDEV_API_KEY=
SETTLEDIFF_OTLP_ENDPOINT=

# Explicit live-test opt-ins. Uncomment only for an authorized invocation.
# SETTLEDIFF_LIVE_HYPERFUSION=1
# SETTLEDIFF_LIVE_CONTEXTDEV=1
# SETTLEDIFF_LIVE_CONTEXTDEV_URL=
# SETTLEDIFF_LIVE_CONTEXTDEV_CLAIM=
# SETTLEDIFF_ALLOW_PAID_TEST=1
